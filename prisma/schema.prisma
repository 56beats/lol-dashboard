generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Match {
  id        String   @id

  champion  String
  win       Boolean

  kills     Int
  deaths    Int
  assists   Int

  gameMode  String
  queueId   Int?
  gameVersion String?

  item0     Int?
  item1     Int?
  item2     Int?
  item3     Int?
  item4     Int?
  item5     Int?
  item6     Int?

  playedAt  DateTime
  createdAt DateTime @default(now())
}

model RankSnapshot {
  id        String   @id @default(cuid())

  queue     String

  tier      String
  rank      String
  lp        Int

  wins      Int
  losses    Int

  createdAt DateTime @default(now())
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Match {
  id         String   @id

  champion   String

  win        Boolean

  kills      Int
  deaths     Int
  assists    Int

  gameMode   String

  playedAt   DateTime

  createdAt  DateTime @default(now())
}